<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isel.icd.ui.game.GameController"
      alignment="CENTER" spacing="12"
      prefWidth="600" prefHeight="500"
      style="-fx-padding: 16;">

    <HBox alignment="CENTER" spacing="40" style="-fx-padding: 8">
        <Label fx:id="lblScoreA" text="A: 0"/>
        <Label fx:id="lblTurn" text=" "/>
        <Label fx:id="lblScoreB" text="B: 0"/>
    </HBox>

    <GridPane fx:id="boardGrid" alignment="CENTER">


    </GridPane>

    <Label fx:id="lblStatus" text="Status Message"/>
    <Button text="Leave" onAction="#onLeaveClicked"/>




</VBox>
