# Dockerfile da camada Web (Tomcat 11 / Jakarta EE 11, porta 8080).
# Build multi-etapa: compila o .war com Maven/JDK 25 e implanta-o como ROOT.

# --- Etapa de build ---
FROM docker.io/library/maven:3.9-eclipse-temurin-25 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -e -DskipTests dependency:go-offline || true
COPY src ./src
# Gera o .war (o JavaFX e excluido do empacotamento pelo maven-war-plugin).
RUN mvn -q -e -DskipTests clean package

# --- Etapa de runtime ---
# Nota: fixar a tag para uma que exista no momento do build; ajustar se preciso.
FROM docker.io/library/tomcat:11.0-jdk25-temurin AS runtime
# Remove as aplicacoes por omissao do Tomcat.
RUN rm -rf /usr/local/tomcat/webapps/*
# Implanta o .war como ROOT (fica acessivel em http://localhost:8080/).
COPY --from=build /app/target/dotsandboxes-*.war /usr/local/tomcat/webapps/ROOT.war
EXPOSE 8080
# O host/porta do servidor de jogo sao injetados via CATALINA_OPTS no compose.
